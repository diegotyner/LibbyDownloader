{
  "manifest_version": 3,
  "name": "Libby DL v2",
  "version": "2.0.0",
  "description": "Intercepts and downloads media API requests on Libby.",
  "permissions": [
    "webRequest",
    "tabs",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.listen.overdrive.com/*",
    "https://*.cdn.overdrive.com/*",
    "https://*.libbyapp.com/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": "icons/Libby_DL_Icon.png"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.js-C2tzpXtr.js"
      ],
      "matches": [
        "https://*.listen.overdrive.com/*",
        "https://*.libbyapp.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.libbyapp.com/*",
        "https://*.listen.overdrive.com/*"
      ],
      "resources": [
        "assets/content.js-C2tzpXtr.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
